# ===========================================
# CPA-Agent 项目根 .gitignore
# ===========================================

# ── 模型缓存 (分层结构) ──
# 保留目录结构 (.gitkeep), 忽略实际模型文件
models/embeddings/*
!models/embeddings/.gitkeep
models/llm/*
!models/llm/.gitkeep
models/mineru/*
!models/mineru/.gitkeep
models/yolo/*
!models/yolo/.gitkeep
# 本机可选解析组件，不提交第三方 JAR
/models/tika/*.jar

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── 虚拟环境 ──
venv/
env/
ENV/
.venv/

# ── 环境变量 ──
.env
.env.local
.env.*.local
backend/.env

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── 日志 ──
*.log
logs/
!logs/.gitkeep

# ── 上传文件 ──
uploads/
!uploads/.gitkeep

# ── 数据库文件 ──
*.db
*.sqlite
*.sqlite3
milvus_data/

# ── OS ──
.DS_Store
Thumbs.db

# ── AI 编辑器配置 (个人 IDE 配置, 非项目源码) ──
.trae/
.agents/
.claude/
.windsurf/
.cursor/
.playwright-mcp/
skills-lock.json

# ── 打包 / 临时产物 ──
*.zip
*.rar
*.7z
backend/mineru_output/
backend/promptfoo/
backend/scripts/smoke_frontend_contracts_result.json
后端源码/
# Celery Beat 的本机状态数据库（不是迁移或任务权威存储）
/backend/celerybeat-schedule
/backend/celerybeat-schedule.*

# ── 历史归档 (早期原型/第三方项目/个人交付物) ──
/archive/
# 后端旧一次性测试归档同样只保留在本机
/backend/archive/
# 2026-07 的旧归档此前未纳入 Git；保留本机现状，不随本轮归档意外加入
/docs/archive/2026-07/
# 上游 OpenCode 参考快照是独立仓库，不随本项目分发
/opencode/

# ── 个人论文文档 ──
网挑文档第七版.docx

# ── 真实业务数据 (含敏感信息且体积大) ──
cleaning_data/jd_data.json

# ── 前端仓库 (独立仓库 cpa-xingtu, 不作为子目录提交) ──
# 仅忽略根目录；docs/frontend/cpa-xingtu/ 契约文档必须纳入版本控制
/cpa-xingtu/
/vue-kecheng/
