# ═══════════════════════════════════════════════════════════════
# CPA-Agent 配置文件模板
# ═══════════════════════════════════════════════════════════════
# 使用说明:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 填写你的 API 密钥和其他配置
#   3. 重启服务生效
# 本模板含本机开发默认密码与 demo 设置，不能直接用于生产。
# 生产镜像与部署门禁见 docs/specs/production-image-hardening.md / DEPLOY.md。
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# 1. LLM 配置 (标准 OpenAI API 格式)
# ───────────────────────────────────────────────────────────────
# 支持所有兼容 OpenAI API 的提供商, 只需切换 LLM_PROVIDER 即可

# 提供商选择 (必填)
# 可选值: openai / deepseek / qwen / kimi / zhipu / ollama / vllm / lmstudio / custom
LLM_PROVIDER=deepseek

# API 密钥 (必填)
# 不同提供商的密钥获取地址:
#   OpenAI:   https://platform.openai.com/api-keys
#   DeepSeek: https://platform.deepseek.com/api_keys
#   通义千问: https://dashscope.console.aliyun.com/apiKey
#   Kimi:     https://platform.moonshot.cn/console/api-keys
#   智谱:     https://open.bigmodel.cn/usercenter/apikeys
LLM_API_KEY=your-api-key-here

# 自定义 API 地址 (可选, 会覆盖内置预设)
# LLM_BASE_URL=https://api.deepseek.com/v1

# 自定义模型名称 (可选, 会覆盖内置预设)
# LLM_MODEL_NAME=deepseek-chat

# 请求超时时间 (秒, 默认 120)
LLM_TIMEOUT=120


# ═══════════════════════════════════════════════════════════════
# 2. 提供商预设参考 (无需修改, 仅供参考)
# ═══════════════════════════════════════════════════════════════
#
# 【云端 API 提供商】
# ┌────────────┬──────────────────────────────────────┬─────────────────────┐
# │ 提供商      │ API 地址                              │ 默认模型             │
# ├────────────┼──────────────────────────────────────┼─────────────────────┤
# │ openai     │ https://api.openai.com/v1            │ gpt-4o-mini         │
# │ deepseek   │ https://api.deepseek.com/v1          │ deepseek-chat       │
# │ qwen       │ https://dashscope.aliyuncs.com/...   │ qwen-plus           │
# │ kimi       │ https://api.moonshot.cn/v1           │ moonshot-v1-8k      │
# │ zhipu      │ https://open.bigmodel.cn/api/paas/v4 │ glm-4               │
# └────────────┴──────────────────────────────────────┴─────────────────────┘
#
# 【本地部署方案】(需要先在本地启动模型服务)
# ┌────────────┬──────────────────────────────────────┬─────────────────────┐
# │ 提供商      │ API 地址                              │ 默认模型             │
# ├────────────┼──────────────────────────────────────┼─────────────────────┤
# │ ollama     │ http://localhost:11434/v1            │ qwen2.5:latest      │
# │ vllm       │ http://localhost:8000/v1             │ Qwen/Qwen2.5-7B...  │
# │ lmstudio   │ http://localhost:1234/v1             │ local-model         │
# └────────────┴──────────────────────────────────────┴─────────────────────┘


# ═══════════════════════════════════════════════════════════════
# 3. 本地大模型部署指南
# ═══════════════════════════════════════════════════════════════
#
# 【方案 A: Ollama (推荐新手)】
#   1. 下载 Ollama: https://ollama.com
#   2. 安装后运行: ollama run qwen2.5:latest
#   3. 配置本文件:
#      LLM_PROVIDER=ollama
#      LLM_API_KEY=ollama  # Ollama 不需要 API 密钥, 填任意值即可
#
# 【方案 B: vLLM (推荐生产环境)】
#   1. 安装: pip install vllm
#   2. 启动: vllm serve Qwen/Qwen2.5-7B-Instruct --api-key empty
#   3. 配置本文件:
#      LLM_PROVIDER=vllm
#      LLM_API_KEY=empty
#
# 【方案 C: LM Studio (图形界面)】
#   1. 下载: https://lmstudio.ai
#   2. 下载并启动任意模型, 开启 Local Server
#   3. 配置本文件:
#      LLM_PROVIDER=lmstudio
#      LLM_API_KEY=lm-studio


# ───────────────────────────────────────────────────────────────
# 4. 应用配置
# ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
FLASK_DEBUG=True
# 生产 Compose 必填：改为真实前端页面的 HTTPS Origin（scheme://host[:port]，无路径/末尾斜杠）；不可用 *。
# 同源 HTTPS 反向代理时填该页面自身 Origin；本机经前端同源代理调试可保持注释。
# 若浏览器直接跨端口携带 Cookie，请显式填前端 Origin，并单独核验凭据/CSRF。
# CORS_ALLOWED_ORIGINS=https://app.example.com
# 单机生产 Compose 的 Gunicorn 参数（默认 2 workers / 4 threads；按内存压测后调整）
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT_SECONDS=180
# 开源/本地演示默认可启动；生产环境请设为 false，使缺 LLM/图数据库配置时启动失败
CPA_DEMO_MODE=true
# Demo 模式固定服务端身份，忽略请求 body/query 中伪造的 student_id/user_id
CPA_DEMO_STUDENT_ID=student_001
# CPA_DEMO_PRINCIPAL_ID=demo:student_001
# Strict 模式（CPA_DEMO_MODE=false）必须由服务端认证适配器提供 Principal，否则用户资源 API 返回 401
# 旧 langgraph_legacy/react 引擎默认关闭；仅 demo 开发排障时显式启用
# CPA_ENABLE_LEGACY_AGENT_ENGINES=false


# ───────────────────────────────────────────────────────────────
# 5. Neo4j 配置
# ───────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_HTTP_PORT=17668
NEO4J_BOLT_PORT=17687


# ───────────────────────────────────────────────────────────────
# 6. MySQL 配置
# ───────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=13306
CPA_MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=!Rootmysql123
MYSQL_PASSWORD=!Rootmysql123
MYSQL_DATABASE=cpa_agent


# ───────────────────────────────────────────────────────────────
# 7. Redis 配置
# ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:16379/0
CPA_REDIS_PORT=16379
# 显式 Idempotency-Key 回合的保守 unknown 窗口与公开响应保留期。
# 响应体到期只表示具备清理资格；需运维调用清理批次，墓碑仍永久保留。
CPA_AGENT_TURN_IDEMPOTENCY_STALE_SECONDS=7200
CPA_AGENT_TURN_IDEMPOTENCY_RETENTION_DAYS=7
# Long PDF/DOCX ingest is delivered by Celery; no in-process thread fallback.
CPA_MEDIA_BROKER_URL=redis://localhost:16379/0


# ───────────────────────────────────────────────────────────────
# 8. Milvus 配置
# ───────────────────────────────────────────────────────────────
# 开发默认使用 Milvus Lite 文件模式，不在 docker-compose 中单独启动 Milvus Server
MILVUS_URI=./milvus_data/milvus.db


# ───────────────────────────────────────────────────────────────
# 9. ReAct Agent 配置
# ───────────────────────────────────────────────────────────────
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.5


# ───────────────────────────────────────────────────────────────
# 10. Embedding 配置
# ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024


# ───────────────────────────────────────────────────────────────
# 11. 模型缓存路径 (分层结构, 缓解 C 盘空间压力)
# ───────────────────────────────────────────────────────────────
# 默认全部走项目内 models/ 子目录, 无需配置即可使用
# 如需切换到其他位置 (如共享模型盘), 取消注释并填入实际路径

# MinerU / ModelScope 缓存 (PDF 解析模型, ~3GB)
# MODELSCOPE_CACHE=D:/path/to/models/mineru

# L0 PDF 引擎策略（能力登记，见 CONTEXT「L0 PDF Engine Registry」）
# CPA_L0_PDF_ENGINE=auto          # auto | sidecar | pymupdf | mineru（auto=Sidecar→PyMuPDF；MinerU 仅显式）
# CPA_L0_PARSE_SIDECAR_URL=http://127.0.0.1:9380
# CPA_L0_MINERU_FORMULA=0         # 显式 mineru 时默认关公式 OCR
# LITELLM_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# CPA_LANGFUSE_CAPTURE_CONTENT=0  # 仅在数据治理已批准时才向 Langfuse 导出 prompt/answer
# CPA_AGENT_MAX_USD=0.50

# 聊天附件 ingest：HTTP 只收字节；worker 先轻量，空则异步升级 L0（默认开）
# CPA_CHAT_INGEST_HEAVY=1         # 0=禁止聊天路径升级 MinerU

# HuggingFace / SentenceTransformer 缓存 (BGE-M3 等, ~2GB)
# HF_HOME=D:/path/to/models/embeddings
# SENTENCE_TRANSFORMERS_HOME=D:/path/to/models/embeddings
# HF_HUB_CACHE=D:/path/to/models/embeddings/hub
# TRANSFORMERS_CACHE=D:/path/to/models/embeddings/transformers
