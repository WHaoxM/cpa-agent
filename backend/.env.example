# ===========================================
# CPA-Agent Backend 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ===========================================

# ============= LLM API 配置 =============
# 支持 OpenAI SDK 格式的任意 LLM API；多厂商故障转移
# LLM_PROVIDER=deepseek
# LLM_FAILOVER_ORDER=deepseek,qwen
# 主密钥（对应 LLM_PROVIDER）:
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
# 分厂商密钥（可选；未设则回退 LLM_API_KEY）:
# LLM_API_KEY_DEEPSEEK=
# LLM_API_KEY_QWEN=
# QWEN_API_KEY=   # 与 LLM_API_KEY_QWEN 等价
# LLM_BASE_URL_QWEN=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_QWEN=qwen-plus

# ============= Neo4j 配置 =============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ============= MySQL 配置 =============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cpa_agent

# ============= Redis 配置 =============
REDIS_URL=redis://localhost:6379/0

# ============= Milvus 配置 =============
# 推荐 CPA_MILVUS_URI（勿把本地 .db 写进 MILVUS_URI：会与 pymilvus 环境变量撞名导致 import 失败）
# Lite: 相对/绝对 .db 路径；独立服务: http://127.0.0.1:19530
CPA_MILVUS_URI=./milvus_data/milvus.db
# 兼容旧名（仅当未设置 CPA_MILVUS_URI 时读取；若为 .db 会在启动时从进程环境剥离）
# MILVUS_URI=http://127.0.0.1:19530

# ============= BGE-M3 Embedding =============
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ============= Flask 配置 =============
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
# Demo 模式固定服务端身份；strict 模式需要认证适配器写入 Principal，否则用户资源 API 返回 401
CPA_DEMO_MODE=true
CPA_DEMO_STUDENT_ID=student_001
# CPA_DEMO_PRINCIPAL_ID=demo:student_001
# CPA_ENABLE_LEGACY_AGENT_ENGINES=false
# CORS 允许的 origin (逗号分隔, 留空=允许全部, 仅开发环境适用)
# 生产环境务必设置为具体域名: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ============= Agent 配置 =============
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.5

# ============= L0 PDF / Parse Sidecar =============
# auto = Sidecar → PyMuPDF（进程内 MinerU 已退出 auto；仅 CPA_L0_PDF_ENGINE=mineru 显式启用）
# CPA_L0_PDF_ENGINE=auto
# CPA_L0_PARSE_SIDECAR_URL=http://127.0.0.1:9380
# CPA_L0_PARSE_SIDECAR_HEALTH=http://127.0.0.1:9380/v1/health
# CPA_L0_PARSE_SIDECAR_PARSE_PATH=/api/cpa/parse
# CPA_L0_MINERU_FORMULA=0
# MINERU_MODEL_SOURCE=modelscope
# MODELSCOPE_CACHE=../models/mineru

# ============= LLMOps (可选) =============
# LITELLM_BASE_URL=http://127.0.0.1:4000
# LITELLM_API_KEY=sk-litellm
# LITELLM_MODEL=deepseek-chat
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# CPA_AGENT_MAX_USD=0.50
