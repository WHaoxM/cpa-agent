# ===========================================
# CPA-Agent Backend 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ===========================================

# ============= LLM API 配置 =============
# 支持 OpenAI SDK 格式的任意 LLM API；多厂商故障转移
# LLM_PROVIDER=deepseek
# LLM_FAILOVER_ORDER=deepseek,qwen
# 主密钥（对应 LLM_PROVIDER）:
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
# 分厂商密钥（可选；未设则回退 LLM_API_KEY）:
# LLM_API_KEY_DEEPSEEK=
# LLM_API_KEY_QWEN=
# QWEN_API_KEY=   # 与 LLM_API_KEY_QWEN 等价
# LLM_BASE_URL_QWEN=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_QWEN=qwen-plus

# ============= Neo4j 配置 =============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ============= MySQL 配置 =============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cpa_agent

# ============= Redis 配置 =============
REDIS_URL=redis://localhost:6379/0

# ============= Milvus 配置 =============
# Milvus Lite 嵌入式模式, 无需额外服务
MILVUS_URI=./milvus_data/milvus.db

# ============= BGE-M3 Embedding =============
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ============= Flask 配置 =============
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
# CORS 允许的 origin (逗号分隔, 留空=允许全部, 仅开发环境适用)
# 生产环境务必设置为具体域名: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ============= Agent 配置 =============
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.5
