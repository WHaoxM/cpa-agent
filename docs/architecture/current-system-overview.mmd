flowchart LR
  subgraph FE["01 · 独立前端 · cpa-xingtu"]
    direction TB
    Mock["Mock data / 本地 fixture<br/>生产默认 · 不连后端"]
    Http["HTTP 联调 · 开发默认<br/>真实 API / SSE"]
  end

  API["02 · Flask API · /api/*<br/>账户身份 · Principal<br/>用户资源按 owner 隔离"]

  subgraph CORE["03 · Agent 与领域服务"]
    direction TB
    Supervisor["Supervisor Agent<br/>Ask · Agent · Experts<br/>子 Agent / 工具白名单"]
    Domain["L0–L4 领域服务<br/>简历 · 图谱 · 画像<br/>匹配 · 报告<br/>异步恢复仅覆盖持久任务子集"]
  end

  subgraph ASYNC["04 · Celery 异步执行"]
    WorkerBeat["Worker：pipeline / media / graph<br/>Beat：周期重放 / 调度<br/>Worker / Beat 分进程；任务经 Redis broker"]
  end

  subgraph DATA["05 · 数据与文件"]
    direction TB
    DataStores["领域客户端 / 文件服务<br/>（按域分散）<br/>MySQL：业务结果权威<br/>Neo4j：技能 / 岗位图谱<br/>Redis：broker / session / cache<br/>非业务结果真值<br/>Milvus Lite：向量检索<br/>文件：上传 / agent_files"]
  end

  LLM["LLM provider<br/>OpenAI-compatible"]
  Sidecar["Parse Sidecar<br/>可选 HTTP · L0"]

  Http -->|"HTTP /api"| API
  API --> Supervisor
  API -->|"领域 API"| Domain
  Supervisor --> Domain
  Supervisor -.->|"推理 / 结构化输出"| LLM
  Domain -.->|"按具体任务 / 配置调用"| LLM
  Domain -.->|"仅 L0 解析配置启用时"| Sidecar
  Domain -->|"指定持久任务（仅部分能力）"| WorkerBeat
  Domain -->|"按领域访问"| DataStores
  WorkerBeat -->|"Worker 任务处理器读写"| DataStores

